# Cấu hình deployment WeKnora tiếng Việt.
# Copy thành .env rồi điền các giá trị <...>. Không commit .env.
# Toàn bộ file được nạp vào container app (env_file trong compose.yaml).

# ===== Cổng trên host =====
# Web UI.
FRONTEND_PORT=80
# REST API, chỉ bind 127.0.0.1 (dùng cho scripts/setup.py và script E2E).
APP_PORT=8080

# ===== Ngôn ngữ và múi giờ =====
# Ngôn ngữ xử lý: ngôn ngữ của câu trả lời, tóm tắt, câu hỏi gợi ý, wiki.
# Thắng header Accept-Language của trình duyệt (code: env > Accept-Language > zh-CN).
WEKNORA_LANGUAGE=vi-VN
# Ngôn ngữ giao diện mặc định, đọc lúc frontend container khởi động.
DEFAULT_LOCALE=en-US
# Bản build-time của DEFAULT_LOCALE. Dockerfile frontend của Fork không nhận
# biến này làm build arg, nên hiện chỉ DEFAULT_LOCALE có tác dụng; giữ để rõ ý.
VITE_DEFAULT_LOCALE=en-US
# Áp cho mọi service.
TZ=Asia/Ho_Chi_Minh

# ===== Database, cache, graph =====
DB_USER=weknora
DB_PASSWORD=<mật khẩu postgres>
DB_NAME=weknora
REDIS_PASSWORD=<mật khẩu redis>
# Bật knowledge graph (Neo4j). Tài khoản neo4j, mật khẩu ít nhất 8 ký tự.
NEO4J_ENABLE=true
NEO4J_PASSWORD=<mật khẩu neo4j>

# ===== Khoá bí mật (sinh một lần, giữ nguyên khi nâng cấp) =====
# openssl rand -hex 32
JWT_SECRET=<chuỗi hex 64 ký tự>
# openssl rand -hex 16  (đúng 32 byte). Mất khoá này thì API key đã lưu không giải mã được.
SYSTEM_AES_KEY=<chuỗi hex 32 ký tự>

# ===== LLM chat (kiêm VLM) - OpenAI-compatible =====
# Từ container, dịch vụ trên host là host.docker.internal. Dịch vụ phải listen
# trên 0.0.0.0 (hoặc IP bridge docker), không chỉ 127.0.0.1.
LLM_BASE_URL=http://host.docker.internal:<port>/v1
# Server không cần key thì điền chuỗi bất kỳ; để trống sẽ gửi nguyên "${LLM_API_KEY}".
LLM_API_KEY=<api key>
LLM_MODEL_NAME=<tên model như server trả ở /v1/models>
# Context window thật của model (token). Bắt buộc là số.
LLM_CONTEXT_WINDOW=<ví dụ 32768>

# ===== embeder-gateway (embedding + rerank) =====
# Base URL có /v1; WeKnora tự nối /embeddings và /rerank.
EMBEDER_GATEWAY_URL=http://host.docker.internal:<port>/v1
# Một key trong GATEWAY_API_KEYS của gateway (gateway từ chối request không có key).
EMBEDER_GATEWAY_API_KEY=<api key>

# ===== Gateway OCR (PaddleOCR-VL /layout-parsing) =====
# Base URL, không có /layout-parsing. scripts/setup.py ghi giá trị này vào
# tenant parser settings; app không đọc trực tiếp biến này.
PADDLEOCR_VL_ENDPOINT=http://host.docker.internal:<port>
# Timeout một request /layout-parsing (cả file PDF đi trong một request).
WEKNORA_PADDLEOCR_VL_TIMEOUT=3600s
# Mỗi lần gọi parser bị giới hạn bởi timeout này (mặc định 30m), nên phải lớn
# hơn timeout PaddleOCR-VL, và nhỏ hơn WEKNORA_DOCUMENT_PROCESS_TIMEOUT.
WEKNORA_DOCREADER_CALL_TIMEOUT=65m
WEKNORA_DOCUMENT_PROCESS_TIMEOUT=2h

# ===== SSRF =====
# Host/IP/CIDR được phép gọi dù là địa chỉ nội bộ, phân cách bằng dấu phẩy.
# Phải chứa host của LLM, embeder-gateway và gateway OCR. Mặc định cả ba ở
# host.docker.internal; thêm IP LAN nếu dịch vụ nằm trên máy khác.
SSRF_WHITELIST=host.docker.internal

# ===== Tài khoản cho scripts/setup.py =====
# Script đăng nhập bằng tài khoản này, chưa có thì tự đăng ký.
WEKNORA_ADMIN_USERNAME=admin
WEKNORA_ADMIN_EMAIL=admin@example.com
WEKNORA_ADMIN_PASSWORD=<mật khẩu, ít nhất 6 ký tự>
# Email tài khoản được nâng thành system admin khi deployment chưa có system admin.
# Đặt trùng WEKNORA_ADMIN_EMAIL. Sau khi setup đăng ký tài khoản, recreate app
# rồi đăng xuất/đăng nhập lại để có quyền "Test connection" cho model built-in.
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=admin@example.com
# Tên knowledge base mẫu (script tìm theo tên này để không tạo trùng).
WEKNORA_KB_NAME=Văn bản pháp luật
